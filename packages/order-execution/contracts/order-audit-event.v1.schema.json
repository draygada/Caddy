{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://strafe.local/contracts/order-audit-event.v1.schema.json",
  "title": "Hash-chained order audit event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "event_sha256", "sequence", "previous_event_sha256", "event_type", "state", "request_id", "receipt_id", "actor_id", "occurred_at", "payload"],
  "properties": {
    "schema_version": {"const": "strafe.order-audit-event/1"},
    "event_id": {"type": "string", "pattern": "^order-event:[0-9a-f]{64}$"},
    "event_sha256": {"$ref": "#/$defs/sha256"},
    "sequence": {"type": "integer", "minimum": 0},
    "previous_event_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "event_type": {"type": "string", "minLength": 1},
    "state": {"enum": ["DRAFT", "DISPATCH_PENDING", "DISPATCHED", "ACKNOWLEDGED", "EXCEPTION", "UNKNOWN", "CLOSED"]},
    "request_id": {"type": "string", "pattern": "^order-request:[0-9a-f]{64}$"},
    "receipt_id": {"type": ["string", "null"], "pattern": "^order-receipt:[0-9a-f]{64}$"},
    "actor_id": {"type": "string", "minLength": 1},
    "occurred_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"},
    "payload": {"type": "object"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
