{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://strafe.local/contracts/sealed-sourcing-package.v1.schema.json",
  "title": "Sealed sourcing package",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_id", "package_status", "candidate", "selections", "files", "seal"],
  "properties": {
    "schema_version": {"const": "strafe.sealed-sourcing-package/1"},
    "package_id": {"type": "string", "minLength": 1},
    "package_status": {"const": "SEALED"},
    "candidate": {"$ref": "#/$defs/candidate"},
    "selections": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/selection"}
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/file"}
    },
    "seal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "manifest_sha256"],
      "properties": {
        "algorithm": {"const": "SHA-256"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "revision", "artifact_sha256"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "artifact_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line_id", "offer_id", "selected", "offer_status", "gate_state"],
      "properties": {
        "line_id": {"type": "string", "minLength": 1},
        "offer_id": {"type": "string", "minLength": 1},
        "selected": {"const": true},
        "offer_status": {"const": "APPROVED"},
        "gate_state": {"const": "CLEARED"}
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "byte_length", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "byte_length": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
