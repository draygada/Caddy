{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://strafe.invalid/forge/classification/contracts/envelope.schema.json",
  "title": "Strafe Forge classification envelope",
  "description": "The one output of the classification engine: items -> candidates -> elements, the route, the claim class and instrument, the questions, the concerns and tensions, and the provenance. Pure data; the payload of an analysis proposal. No numeric confidence exists anywhere in it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "snapshot_sha256", "pack_sha256", "item", "readiness", "candidates", "route", "claim_class", "claim_class_reason", "claim_class_ceiling", "ceiling_reason", "recommended_instrument", "questions", "concerns", "legal_tensions", "provenance"],
  "properties": {
    "schema_version": {"const": "forge-classification.envelope/1"},
    "snapshot_sha256": {"$ref": "#/$defs/hex64"},
    "pack_sha256": {"$ref": "#/$defs/hex64"},
    "item": {
      "type": "object", "additionalProperties": false, "required": ["part_revision_id", "item_kind"],
      "properties": {
        "part_revision_id": {"type": "string", "minLength": 1},
        "item_kind": {"enum": ["commodity", "software", "technology"]}
      }
    },
    "readiness": {
      "type": "object", "additionalProperties": false, "required": ["band", "missing_fields", "blocking_fields"],
      "properties": {
        "band": {"enum": ["insufficient", "preliminary", "classifiable"]},
        "missing_fields": {"type": "array", "items": {"type": "string"}},
        "blocking_fields": {"type": "array", "items": {"type": "string"}}
      }
    },
    "candidates": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
    "route": {
      "type": "object", "additionalProperties": false,
      "required": ["usml_step", "ccl_step", "posture", "leading_candidate_id", "order_of_review_trace"],
      "properties": {
        "usml_step": {"enum": ["supported", "negative", "ambiguous", "blocked_on_facts"]},
        "ccl_step": {"enum": ["specific_supported", "all_knocked_out", "ambiguous", "blocked_on_facts", "not_reached"]},
        "posture": {"enum": ["ITAR", "EAR", "EAR99", "AMBIGUOUS"]},
        "leading_candidate_id": {"type": ["string", "null"]},
        "order_of_review_trace": {"type": "array", "items": {"type": "string"}}
      }
    },
    "claim_class": {"enum": ["insufficient_facts", "conditional", "supported", "ambiguous"]},
    "claim_class_reason": {"type": "string", "minLength": 1},
    "claim_class_ceiling": {"enum": ["conditional", "supported"]},
    "ceiling_reason": {"type": ["string", "null"]},
    "recommended_instrument": {"enum": ["cj", "ccats", "counsel", null]},
    "questions": {"type": "array", "items": {"$ref": "#/$defs/question"}},
    "concerns": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["type", "statement", "basis"],
        "properties": {
          "type": {"enum": ["alternate_use", "misuse_plausibility", "declared_use_inconsistency", "transaction_risk", "practitioner_scrutiny"]},
          "statement": {"type": "string"}, "basis": {"type": "string"}
        }
      }
    },
    "legal_tensions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["type", "statement"],
        "properties": {
          "type": {"enum": ["strictest_rule", "premature_regime_dismissal", "destination_as_classification", "use_as_dispositive", "other"]},
          "statement": {"type": "string"}
        }
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["model", "calls", "budget", "dropped_candidates", "reference_notes"],
      "properties": {
        "model": {"type": "string"},
        "calls": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["stage", "provision", "prompt_sha256", "response_sha256", "input_tokens", "output_tokens", "cost_microusd"],
            "properties": {
              "stage": {"type": "string"},
              "provision": {"type": ["string", "null"]},
              "prompt_sha256": {"$ref": "#/$defs/hex64"},
              "response_sha256": {"oneOf": [{"$ref": "#/$defs/hex64"}, {"type": "null"}]},
              "input_tokens": {"type": "integer", "minimum": 0},
              "output_tokens": {"type": "integer", "minimum": 0},
              "cost_microusd": {"type": "integer", "minimum": 0}
            }
          }
        },
        "budget": {
          "type": "object", "additionalProperties": false,
          "required": ["calls_cap", "calls_used", "cost_cap_microusd", "cost_used_microusd"],
          "properties": {
            "calls_cap": {"type": "integer", "minimum": 0}, "calls_used": {"type": "integer", "minimum": 0},
            "cost_cap_microusd": {"type": "integer", "minimum": 0}, "cost_used_microusd": {"type": "integer", "minimum": 0}
          }
        },
        "dropped_candidates": {
          "type": "array",
          "items": {"type": "object", "additionalProperties": false, "required": ["provision", "reason"],
                    "properties": {"provision": {"type": "string"}, "reason": {"type": "string"}}}
        },
        "reference_notes": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"claim_class": {"const": "supported"}}},
      "then": {
        "properties": {
          "claim_class_ceiling": {"const": "supported"},
          "candidates": {
            "items": {
              "if": {"properties": {"status": {"const": "leading"}}},
              "then": {
                "properties": {
                  "elements": {
                    "items": {
                      "if": {"properties": {"disposition": {"const": "met"}}},
                      "then": {"properties": {"facts_relied_on": {"items": {"properties": {"evidence_grade": {"enum": ["verified", "attested"]}}}}}}
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"claim_class": {"const": "ambiguous"}}},
      "then": {"properties": {"recommended_instrument": {"enum": ["cj", "ccats", "counsel"]}}},
      "else": {"properties": {"recommended_instrument": {"const": null}}}
    }
  ],
  "$defs": {
    "hex64": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "citation": {
      "type": "object", "additionalProperties": false,
      "required": ["unit_key", "unit_sha256", "start", "end", "quote"],
      "properties": {
        "unit_key": {"type": "string", "minLength": 1},
        "unit_sha256": {"$ref": "#/$defs/hex64"},
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 0},
        "quote": {"type": "string", "minLength": 1}
      }
    },
    "fact_ref": {
      "type": "object", "additionalProperties": false, "required": ["path", "evidence_grade"],
      "properties": {"path": {"type": "string", "minLength": 1}, "evidence_grade": {"enum": ["asserted", "attested", "verified"]}}
    },
    "element": {
      "type": "object", "additionalProperties": false,
      "required": ["element_id", "unit_key", "disposition", "basis", "facts_relied_on", "citation", "missing_fact"],
      "properties": {
        "element_id": {"type": "string", "minLength": 1},
        "unit_key": {"type": "string", "minLength": 1},
        "disposition": {"enum": ["met", "not_met", "indeterminate"]},
        "basis": {"enum": ["stated", "inferred", "assumed"]},
        "facts_relied_on": {"type": "array", "items": {"$ref": "#/$defs/fact_ref"}},
        "citation": {"oneOf": [{"$ref": "#/$defs/citation"}, {"type": "null"}]},
        "missing_fact": {
          "oneOf": [
            {"type": "object", "additionalProperties": false, "required": ["fact_path", "question"],
             "properties": {"fact_path": {"type": "string", "minLength": 1}, "question": {"type": "string", "minLength": 1}}},
            {"type": "null"}
          ]
        }
      }
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_id", "provision", "stage", "status", "pursuit", "origin", "why_considered", "why_rejected", "why_over_alternative", "intended_use_rationale", "intended_use_family", "elements", "fit_quality", "challenge", "reference_notes"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "provision": {"type": "string", "minLength": 1},
        "stage": {"enum": ["usml_enumerated", "specially_designed_itar", "six_hundred_series", "specially_designed_ear", "other_ccl", "residual"]},
        "status": {"enum": ["leading", "knocked_out", "blocked_on_facts", "not_reached"]},
        "pursuit": {"enum": ["worth_pursuing", "explicitly_not", null]},
        "origin": {"enum": ["proposed", "floor", "intake_trigger"]},
        "why_considered": {"type": "string"},
        "why_rejected": {"type": ["string", "null"]},
        "why_over_alternative": {"type": ["string", "null"]},
        "intended_use_rationale": {"type": ["string", "null"]},
        "intended_use_family": {"enum": ["end_use_nature", "destination_and_parties", "capability_in_fact", null]},
        "elements": {"type": "array", "items": {"$ref": "#/$defs/element"}},
        "fit_quality": {"enum": ["close", "partial", "thin", "none", null]},
        "challenge": {
          "oneOf": [
            {"type": "object", "additionalProperties": false, "required": ["text", "resolution"],
             "properties": {"text": {"type": "string"}, "resolution": {"enum": ["sustained", "rejected"]}}},
            {"type": "null"}
          ]
        },
        "reference_notes": {"type": "array", "items": {"type": "string"}}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "knocked_out"}}},
          "then": {
            "properties": {
              "why_rejected": {"type": "string", "minLength": 1},
              "elements": {
                "contains": {
                  "type": "object",
                  "properties": {"disposition": {"const": "not_met"}, "citation": {"type": "object"}},
                  "required": ["disposition", "citation"]
                }
              }
            }
          }
        }
      ]
    },
    "question": {
      "type": "object", "additionalProperties": false,
      "required": ["question_id", "fact_path", "text", "unblocks", "rank", "source"],
      "properties": {
        "question_id": {"type": "string", "minLength": 1},
        "fact_path": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "unblocks": {
          "type": "array",
          "items": {"type": "object", "additionalProperties": false, "required": ["candidate_id", "element_id"],
                    "properties": {"candidate_id": {"type": "string"}, "element_id": {"type": ["string", "null"]}}}
        },
        "rank": {"type": "integer", "minimum": 0},
        "source": {"enum": ["readiness_blocking", "readiness_missing", "element_missing_fact"]}
      }
    }
  }
}
