{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tripwire.local/schemas/evaluate-response.candidate.schema.json",
  "title": "Candidate evaluate response — shape only, unapproved",
  "description": "Wave-0 response contract. Every conforming candidate is stubbed fixture output; this schema is not an approved rule pack or legal result.",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "stub", "fixture_mode", "artifact_status", "design_revision", "rule_pack_sha", "rule_pack_status", "destination_policy_sha", "ecfr_date", "determinations", "delta", "summary"],
  "properties": {
    "request_id": {"type": "integer", "minimum": 0},
    "stub": {"const": true},
    "fixture_mode": {"enum": ["SYNTHETIC_DEMO", "NON_DEMO_SYNTHETIC"]},
    "artifact_status": {"const": "candidate_unapproved"},
    "design_revision": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "rule_pack_sha": {
      "oneOf": [
        {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        {"type": "null"}
      ]
    },
    "rule_pack_status": {"enum": ["unapproved_input", "synthetic_test_only", "not_loaded"]},
    "destination_policy_sha": {"type": "null"},
    "ecfr_date": {"oneOf": [{"type": "string", "format": "date"}, {"type": "null"}]},
    "determinations": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/determination"}
    },
    "delta": {"$ref": "#/$defs/delta"},
    "summary": {"$ref": "#/$defs/summary"}
  },
  "$defs": {
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attribute", "observed", "unit", "operator", "threshold"],
      "properties": {
        "attribute": {"type": "string", "minLength": 1},
        "observed": {"type": ["number", "string", "boolean", "array", "null"]},
        "unit": {"type": ["string", "null"]},
        "operator": {"enum": ["<", "<=", ">", ">=", "equals", "in", "requires_entry"]},
        "threshold": {"type": ["number", "string", "boolean", "array", "null"]}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "sha256", "span"],
      "properties": {
        "level": {"enum": ["synthetic", "declared", "verified", "missing"]},
        "sha256": {"oneOf": [{"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, {"type": "null"}]},
        "span": {
          "oneOf": [
            {
              "type": "array",
              "prefixItems": [{"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 1}],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            {"type": "null"}
          ]
        }
      }
    },
    "tripwire": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "state", "jurisdiction", "entry", "reason_for_control", "node_id", "cause_node_id", "facts", "text", "source_url", "ecfr_date", "rule_effective", "evidence"],
      "properties": {
        "rule_id": {"type": "string", "minLength": 1},
        "state": {"enum": ["fired", "not_fired", "cannot_evaluate"]},
        "jurisdiction": {"enum": ["ITAR", "EAR", "EAR99", null]},
        "entry": {"type": "string", "minLength": 1},
        "reason_for_control": {"type": "array", "items": {"type": "string"}},
        "node_id": {"type": "string", "minLength": 1},
        "cause_node_id": {"type": "string", "minLength": 1},
        "path": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
        "problem": {"enum": ["missing_fact", "stale_fact", "incompatible_unit", "semantic_approval_missing"]},
        "facts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fact"}},
        "text": {"type": "string", "minLength": 1},
        "source_url": {"type": "string", "format": "uri"},
        "ecfr_date": {"oneOf": [{"type": "string", "format": "date"}, {"type": "null"}]},
        "rule_effective": {"oneOf": [{"type": "string", "format": "date"}, {"type": "null"}]},
        "evidence": {"$ref": "#/$defs/evidence"}
      }
    },
    "propagatedTripwire": {
      "allOf": [
        {"$ref": "#/$defs/tripwire"},
        {"required": ["path"]}
      ]
    },
    "unresolvedTripwire": {
      "allOf": [
        {"$ref": "#/$defs/tripwire"},
        {"properties": {"state": {"const": "cannot_evaluate"}}, "required": ["problem"]}
      ]
    },
    "destinations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": {"const": "not_evaluated"},
        "reason": {"const": "P0 has no approved destination policy"}
      }
    },
    "determination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "jurisdiction", "entries", "direct_tripwires", "propagated_tripwires", "unresolved_tripwires", "destinations", "evidence_level"],
      "properties": {
        "state": {"enum": ["clear", "watch", "question", "flag"]},
        "jurisdiction": {"enum": ["ITAR", "EAR", "EAR99", null]},
        "entries": {"type": "array", "items": {"type": "string"}},
        "direct_tripwires": {"type": "array", "items": {"$ref": "#/$defs/tripwire"}},
        "propagated_tripwires": {"type": "array", "items": {"$ref": "#/$defs/propagatedTripwire"}},
        "unresolved_tripwires": {"type": "array", "items": {"$ref": "#/$defs/unresolvedTripwire"}},
        "destinations": {"$ref": "#/$defs/destinations"},
        "evidence_level": {"enum": ["synthetic", "declared", "verified", "missing"]}
      }
    },
    "tripwireDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "rule_id", "kind"],
      "properties": {
        "node_id": {"type": "string", "minLength": 1},
        "rule_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["direct", "propagated", "unresolved"]},
        "cause_node_id": {"type": "string", "minLength": 1}
      }
    },
    "delta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changed_nodes", "tripwires_added", "tripwires_removed", "rules_evaluated"],
      "properties": {
        "changed_nodes": {"type": "array", "items": {"type": "string"}},
        "tripwires_added": {"type": "array", "items": {"$ref": "#/$defs/tripwireDelta"}},
        "tripwires_removed": {"type": "array", "items": {"$ref": "#/$defs/tripwireDelta"}},
        "rules_evaluated": {"type": "array", "items": {"type": "string"}}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clear", "watch", "question", "flag"],
      "properties": {
        "clear": {"type": "integer", "minimum": 0},
        "watch": {"type": "integer", "minimum": 0},
        "question": {"type": "integer", "minimum": 0},
        "flag": {"type": "integer", "minimum": 0}
      }
    }
  }
}
